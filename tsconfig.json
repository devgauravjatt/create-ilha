{
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    "strictNullChecks": true,
    "module": "ESNext",
    "target": "ES2022",
    "strict": true,
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "include": ["src", "tests"],
  "exclude": ["templates"]
}
