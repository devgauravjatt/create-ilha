{
  "name": "create-ilha",
  "version": "0.5.0",
  "description": "The official project scaffolding tool for Ilha.",
  "keywords": [
    "cli",
    "create",
    "ilha",
    "islands",
    "scaffold",
    "starter",
    "template",
    "vite"
  ],
  "homepage": "https://github.com/devgauravjatt/create-ilha#readme",
  "bugs": {
    "url": "https://github.com/devgauravjatt/create-ilha/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devgauravjatt/create-ilha.git"
  },
  "bin": {
    "create-ilha": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib",
    "dev": "rslib --watch",
    "format": "ultracite fix",
    "lint": "ultracite check",
    "prepare": "husky",
    "start": "node ./dist/index.js",
    "link": "pnpm add -g .",
    "test": "rslib && node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@rslib/core": "^0.23.2",
    "@types/node": "^24.13.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "^6.0.3",
    "ultracite": "7.9.4"
  },
  "engines": {
    "node": ">=20"
  }
}
