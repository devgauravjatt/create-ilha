---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { description = "Built with Astro and Ilha islands.", title } = Astro.props;
const siteName = "{{projectName}}";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href="/">{siteName}</a>
      <nav>
        <a href="/">Home</a>
        <a href="/about">About</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>
        Built with <a href="https://astro.build">Astro</a> and
        <a href="https://ilha.build">Ilha</a>.
      </p>
    </footer>
  </body>
</html>
